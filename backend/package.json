{
  "name": "@wonderlab/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:bootstrap-admin": "tsx src/db/bootstrap-admin.ts",
    "db:seed-rewards": "tsx src/db/reward-seed.ts",
    "db:seed-maths": "tsx src/db/maths-seed.ts",
    "db:seed-story": "tsx src/db/story-seed.ts"
  },
  "dependencies": {
    "@wonderlab/shared": "*",
    "express": "^5.1.0",
    "mysql2": "^3.15.3",
    "bcryptjs": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "multer": "^2.0.2",
    "dotenv": "^17.2.3",
    "pdf-parse": "^2.4.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
